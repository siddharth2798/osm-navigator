<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Android Auto (phone-projection) declaration — see
             res/xml/automotive_app_desc.xml and
             com.navigator.app.auto.CarNavService. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Required — the host throws IllegalArgumentException("Min API
             level not declared in manifest") and shows a generic "app
             encountered an error" screen without this, confirmed live via
             logcat (CarApp.H.Tem, androidx.car.app.AppInfo.create). Value 2
             matches androidx.car.app.versioning.CarAppApiLevels.LEVEL_2 —
             checked against the actual androidx.car.app:app:1.7.0 jar via
             javap: NavigationTemplate/NavigationTemplate.Builder.setActionStrip
             are @RequiresCarApi(2), nothing this app uses requires higher
             (TravelEstimate.Builder.setTripText/setTripIcon are gated at 5,
             but neither is called here). -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="2" />

        <service
            android:name=".auto.CarNavService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Makes this app a target in Android's system Share sheet — e.g.
                 sharing a place straight from the Google Maps app. A separate
                 intent-filter from the LAUNCHER one above, not merged into it,
                 so this app still has exactly one unambiguous home-screen
                 launcher entry. See MainActivity.handleShareIntent, which
                 turns the incoming Intent's EXTRA_TEXT into the same
                 ?text=/&title= URL shape app.js's parseShareTargetParam()
                 already reads for the PWA's own Web Share Target
                 (manifest.json) — one JS-side code path handles both. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Gates NavigationTemplate/NavigationManager — added ahead of Phase 1
         (see the plan doc), since MessageTemplate itself doesn't need it,
         but the next phase does and this permission can't be requested at
         runtime the way a normal dangerous permission can. -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <!-- Required for AppManager.setSurfaceCallback() — confirmed live: without
         this, the host throws SecurityException("The car app does not have a
         required permission: androidx.car.app.ACCESS_SURFACE") the instant
         NavigationScreen's constructor calls it, crashing the whole app. -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
</manifest>
