{
  // Must match this Worker's existing name in the Cloudflare dashboard, or a
  // redeploy creates a new Worker instead of updating this one.
  "name": "osm-navigator",
  "compatibility_date": "2026-08-16",
  "main": "./worker.js",
  "assets": {
    // Static files are served directly; worker.js only runs for /api/resolve-maps-url.
    "directory": "./",
    "binding": "ASSETS"
  }
  // Optional: secret spot collections (docs/SPOT_COLLECTIONS.md). Create the database with
  // `wrangler d1 create osm-navigator-spots`, paste its id below and uncomment (add a comma after the
  // "assets" block). Without this binding the /api/spots routes return 501 and the feature stays
  // invisible in the app.
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "osm-navigator-spots", "database_id": "<id from wrangler d1 create>", "migrations_dir": "migrations" }
  // ]
}
