{
	// Must match this Worker's existing name in the Cloudflare dashboard, or a
	// redeploy creates a new Worker instead of updating this one.
	"name": "osm-navigator",
	"compatibility_date": "2026-08-16",
	"main": "./worker.js",
	"assets": {
		// Static files are served directly; worker.js only runs for /api/resolve-maps-url.
		"directory": "./",
		"binding": "ASSETS"
	},
	// Secret spot collections (docs/SPOT_COLLECTIONS.md). The binding MUST be named "DB" — lib/spots-api.js
	// reads env.DB, and without it every /api/spots route answers 501. (Do not add "remote": true: that makes
	// `wrangler dev` read and write this production database.)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "osm-navigator-spots",
			"database_id": "e05e582c-96f2-43a3-be0a-963d94119b6f",
			"migrations_dir": "migrations"
		}
	]
}
