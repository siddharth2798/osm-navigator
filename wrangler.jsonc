{
  // Deliberately DIFFERENT from main's Worker name ("osm-navigator") —
  // this branch (personal/flight-tracking, the "AeroNav" app) used to
  // share that same name/Worker with main, on the assumption that
  // Cloudflare's Git integration would redeploy the one shared Worker on
  // every push regardless of branch. Confirmed live that's false: the
  // integration's production-branch setting only promotes main's pushes
  // to the real osm-navigator.*.workers.dev URL — this branch's pushes
  // were landing in a preview environment the whole time, never the URL
  // config.js's RESOLVE_MAPS_URL_BASE actually points the app at (caught
  // when the deployed /api/flights still answered with the pre-OpenSky
  // adsb.lol source, long after that switch shipped here).
  //
  // This got renamed once already (to "aeronav") to fix exactly that, but
  // the dashboard-side Workers Builds project that was actually created
  // ended up named "osm-aeronav" instead — a naming mismatch discovered
  // live via the EXACT SAME adsb.lol symptom recurring a second time,
  // against a Worker that (unlike the first shared-Worker case) genuinely
  // does exist and respond, just under a different hostname than this
  // file specified. Renamed here to match the real, live deployment
  // rather than asking for the dashboard project to be recreated again —
  // config.js's RESOLVE_MAPS_URL_BASE must always match this name exactly.
  "name": "osm-aeronav",
  "compatibility_date": "2026-08-16",
  "main": "./worker.js",
  "assets": {
    // Static assets take priority over the Worker script for any request
    // that matches a real file — worker.js only ever runs as a fallback for
    // /api/resolve-maps-url, which isn't a file. Every other page/script/
    // style/tile-cache request is served exactly as before this file existed.
    "directory": "./",
    "binding": "ASSETS"
  }
}
